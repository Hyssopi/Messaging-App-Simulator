{
  "name": "messaging-app-simulator",
  "version": "2.0.0",
  "description": "Messaging App Simulator.",
  "main": "build/dist/bundle.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --outfile=build/dist/bundle.js --platform=browser --format=esm --target=es2022",
    "clean": "tsc --build --clean && if exist build\\dist rmdir /s /q build\\dist",
    "lint": "prettier --write . && eslint --fix .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
